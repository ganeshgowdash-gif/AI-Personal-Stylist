# Supabase Configuration
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Vision & Styling Configuration (Claude 3.5 Sonnet)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Dedicated Image Generation Provider
# If left empty, the application uses high-definition fashion generation with prompt refinement
IMAGE_GEN_PROVIDER=pollinations
# Optional keys if you wish to use OpenAI DALL-E 3 or Fal:
OPENAI_API_KEY=
FAL_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

